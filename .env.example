# ScriptSync 环境变量样例
# 复制为 .env 后填写实际值

# JWT 密钥（前后端、协作服务端必须一致）
JWT_SECRET=change-this-to-a-random-string

# 百炼 AI 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
# 模型选择（精度优先，可按实测切换）
# 备选：qwen-max, deepseek-v3, qwen-plus
AI_MODEL=qwen-max

# 协作服务端地址（前端连接用）
VITE_COLLAB_WS_URL=ws://localhost:1234
# API 地址（前端调用用）
VITE_API_URL=http://localhost:8000
